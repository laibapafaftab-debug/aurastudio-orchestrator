# Copy this file to .env and fill it in. NEVER commit .env.

# development or production. Production refuses to start with a weak SECRET_KEY or insecure cookies.
APP_ENV=development

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Dashboard login (one admin). Create the hash with: python backend/scripts/hash_password.py
# Keep the single quotes around the hash.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=''

# Database. Docker default (SQLite inside a volume):
DATABASE_URL=sqlite:////srv/data/aurastudio.db
# Local run without Docker:  sqlite:///./data/aurastudio.db
# Supabase / Postgres:       postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Websites allowed to send leads (exact origins, comma separated, no trailing slash)
SITE_ORIGINS=http://localhost:8080

# Set to true when the dashboard is served over HTTPS (required in production)
COOKIE_SECURE=false
# Only set to true when the backend sits behind YOUR reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
SESSION_HOURS=8

# AI scoring (optional). Without a key, simple rules score the leads.
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-5-5

# n8n hand-off (optional). Inside Docker the address is http://n8n:5678/webhook/aurastudio-lead
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Used by the n8n container to encrypt stored credentials. Generate like SECRET_KEY.
N8N_ENCRYPTION_KEY=
TZ=Asia/Karachi

# ---- Production only (docker-compose.prod.yml) ----
# Their DNS records must point at your server before you start the stack.
DASHBOARD_DOMAIN=dashboard.example.com
API_DOMAIN=api.example.com
# Optional, only if you expose the n8n editor through Caddy (see docs/deployment.md)
# N8N_DOMAIN=n8n.example.com
# Behind Caddy (which sets X-Forwarded-For itself) set TRUST_PROXY=true and COOKIE_SECURE=true above.
